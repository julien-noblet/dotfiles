{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh

if [ ! -f "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt" ]; then
	{{ if not (or (eq .chezmoi.osRelease.id "nixos") (eq .chezmoi.osRelease.id "glfos")) }}
	chezmoi age decrypt --output "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt" --passphrase "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt.age"
	chmod 600 "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
	{{ else }}
	nix run nixpkgs#age -- -d  "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt.age" >  "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
	{{ end }}
fi
{{- end -}}
